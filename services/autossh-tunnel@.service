[Unit]
Description=autossh reverse tunnel %i
Wants=network-online.target
After=network-online.target

[Service]
# Per-tunnel settings live in /etc/autossh/%i.env (see services/tunnel.env.example).
# User is set by a drop-in written by `bootstrap.sh --services`.
EnvironmentFile=/etc/autossh/%i.env
Environment=AUTOSSH_GATETIME=0
ExecStart=/usr/bin/autossh -M 0 -N \
    -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
    -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=accept-new \
    -i ${SSH_KEY} -R ${FORWARD} ${REMOTE}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
