# Copy to <dir>/<name>.env (e.g. ssh.env, jupyter.env) and run:
#   scripts/bootstrap.sh --services <dir>

# Private key used to log in to the VPS (readable by the service user).
SSH_KEY=/home/youruser/.ssh/id_ed25519
# user@host of the VPS.
REMOTE=user@vps.example.com
# -R spec: <remote port>:<local host>:<local port>. Use unique remote ports per machine.
FORWARD=8878:localhost:22
